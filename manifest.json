{
  "manifest_version": 3,
  "name": "AdCheck",
  "description": "Debug and verify ad tag implementations on publisher websites.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage", "scripting", "webRequest", "tabs", "userScripts"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AdCheck",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/defaults.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
