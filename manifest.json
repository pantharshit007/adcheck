{
	"manifest_version": 3,
	"name": "AdCheck - Ad Tag QA & Debugging Toolkit",
	"description": "Debug and verify ad tag implementations on publisher websites.",
	"version": "1.1.7",
	"permissions": [
		"activeTab",
		"storage",
		"webRequest",
		"tabs",
		"userScripts",
		"declarativeNetRequest"
	],
	"host_permissions": ["http://*/*", "https://*/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "AdCheck",
		"default_popup": "popup.html"
	},
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["shared/defaults.js", "shared/build-info.js", "content.js"],
			"css": ["styles.css"],
			"run_at": "document_start"
		}
	]
}
